# Production environment template for ai-creator-server
# Copy this file to server/.env on the target Linux host and replace every placeholder.

NODE_ENV=production
PORT=3000

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_creator
DB_USER=ai_creator_user
DB_PASSWORD=PLEASE_REPLACE_WITH_DATABASE_PASSWORD

# Site / app
SITE_NAME=AI Creator
APP_NAME=AI Creator
PUBLIC_APP_NAME=AI Creator
SITE_API_DOMAIN=https://api.example.com
PUBLIC_API_DOMAIN=https://api.example.com
APP_PUBLIC_URL=https://api.example.com

# Security
# JWT_SECRET must be replaced with a strong random string in production.
JWT_SECRET=PLEASE_REPLACE_WITH_A_STRONG_RANDOM_STRING
JWT_EXPIRES_IN=7200
# ENCRYPTION_KEY is used to decrypt stored secrets and payloads.
# Do not change ENCRYPTION_KEY casually after go-live.
ENCRYPTION_KEY=PLEASE_REPLACE_WITH_A_STRONG_RANDOM_STRING
# Comma-separated browser origins allowed to call APIs cross-origin.
# Same-origin admin/API calls and non-browser requests are still allowed without this header.
CORS_ALLOWED_ORIGINS=https://api.example.com
ENABLE_HSTS=true
# Optional override. Leave empty to use the built-in admin/API CSP.
CONTENT_SECURITY_POLICY=

# Runtime paths
APP_ROOT_DIR=/www/wwwroot/ai-creator
UPDATE_PACKAGES_DIR=/www/wwwroot/ai-creator/update-packages
PM2_APP_NAME=ai-creator
HEALTH_CHECK_URL=http://127.0.0.1:3000/health
SYSTEM_CHECK_URL=http://127.0.0.1:3000/api/v1/admin/system/check
SYSTEM_CHECK_TOKEN=PLEASE_REPLACE_WITH_ADMIN_HEALTH_TOKEN

# Logging and background jobs
# Application logs are written to stdout/stderr and should be captured by PM2.
CHECK_DISABLE_QUEUE=false
CHECK_DISABLE_VIDEO_POLLING=false
TASK_QUEUE_STALE_QUEUED_MINUTES=30
TASK_QUEUE_STALE_PROCESSING_MINUTES=60
TASK_QUEUE_STALE_MAX_BATCH=100
TASK_QUEUE_MAX_LENGTH=500
AI_TASK_CREATE_RATE_LIMIT_PER_MINUTE=10
ADMIN_AI_TEST_RATE_LIMIT_PER_MINUTE=3
TASK_OUTPUT_TRANSFER_ATTEMPTS=3
VIDEO_TASK_POLL_INTERVAL_SECONDS=20
VIDEO_TASK_MAX_RUNNING_MINUTES=30
VIDEO_TASK_STALE_PROCESSING_MINUTES=45
VIDEO_TASK_POLL_BATCH_SIZE=10
VIDEO_TASK_MAX_POLL_COUNT=120
VIDEO_TASK_MAX_FILE_MB=200
VIDEO_TASK_DOWNLOAD_TIMEOUT_SECONDS=120
VIDEO_TASK_UPLOAD_TIMEOUT_SECONDS=180
VIDEO_TASK_TMP_DIR=/tmp/ai-creator-video

# WeChat login
WECHAT_APP_ID=PLEASE_REPLACE_WITH_WECHAT_APP_ID
WECHAT_APP_SECRET=PLEASE_REPLACE_WITH_WECHAT_APP_SECRET
WECHAT_LOGIN_ENABLED=true
WECHAT_LOGIN_BYPASS=false

# WeChat pay
WECHAT_PAY_ENABLED=false
WECHAT_PAY_APPID=PLEASE_REPLACE_WITH_WECHAT_PAY_APPID
WECHAT_PAY_MCHID=PLEASE_REPLACE_WITH_WECHAT_PAY_MCHID
WECHAT_PAY_MCH_ID=PLEASE_REPLACE_WITH_WECHAT_PAY_MCHID
WECHAT_PAY_API_V3_KEY=PLEASE_REPLACE_WITH_WECHAT_PAY_API_V3_KEY
WECHAT_PAY_PRIVATE_KEY=PLEASE_REPLACE_WITH_WECHAT_PAY_PRIVATE_KEY
WECHAT_PAY_MERCHANT_SERIAL_NO=PLEASE_REPLACE_WITH_WECHAT_PAY_SERIAL_NO
WECHAT_PAY_SERIAL_NO=PLEASE_REPLACE_WITH_WECHAT_PAY_SERIAL_NO
WECHAT_PAY_NOTIFY_URL=PLEASE_REPLACE_WITH_WECHAT_PAY_NOTIFY_URL
WECHAT_PAY_PLATFORM_CERT_SERIAL_NO=PLEASE_REPLACE_WITH_PLATFORM_CERT_SERIAL_NO
WECHAT_PAY_PLATFORM_CERT=PLEASE_REPLACE_WITH_PLATFORM_CERT_PEM
WECHAT_PAY_ENV=production
WECHAT_PAY_TIMEOUT_MINUTES=30
WECHAT_PAY_VERIFY_SIGNATURE=true
WECHAT_PAY_REFUND_ENABLED=true

# Membership / invite / ads / signin
MEMBERSHIP_ENABLED=true
INVITE_ENABLED=true
INVITE_REWARD_ON_USE_ENABLED=true
INVITE_REWARD_ON_USE_POINTS=0
INVITE_REWARD_ON_MEMBER_ENABLED=true
INVITE_REWARD_ON_MEMBER_POINTS=0
INVITE_MAX_REWARD_PER_DAY=100
AD_REWARD_ENABLED=false
AD_REWARD_POINTS_PER_WATCH=0
AD_REWARD_MAX_DAILY_COUNT=0
AD_REWARD_AD_UNIT_ID=PLEASE_REPLACE_WITH_AD_UNIT_ID
SIGNIN_ENABLED=true
SIGNIN_NORMAL_ENABLED=true
SIGNIN_SUPER_ENABLED=true
SIGNIN_SUPER_REQUIRES_AD=false
SIGNIN_REWARDS_JSON=[]
SIGNIN_SUPER_REWARDS_JSON=[]
SIGNIN_ALLOW_MAKEUP=true
SIGNIN_MAKEUP_COST_POINTS=0

# AI feature fallback flags
AI_PROMPT_OPTIMIZE_ENABLED=true
AI_PROMPT_OPTIMIZE_MODEL_ID=
AI_PROMPT_OPTIMIZE_POINTS_COST=0
AI_SCRIPT_GENERATE_ENABLED=true
AI_SCRIPT_GENERATE_MODEL_ID=
AI_SCRIPT_GENERATE_POINTS_COST=0
AI_PROMPT_GENERATE_ENABLED=true
AI_PROMPT_GENERATE_MODEL_ID=
AI_PROMPT_GENERATE_POINTS_COST=0
AI_STORYBOARD_GENERATE_ENABLED=true
AI_STORYBOARD_GENERATE_MODEL_ID=
AI_STORYBOARD_GENERATE_POINTS_COST=0

# AI provider API keys
# db:migrate/install encrypts these into ai_model_providers; do not put real keys in SQL seed files.
OPENAI_API_KEY=
XIAOMA_API_KEY=
BAGEGE_API_KEY=
WELLAPI_API_KEY=
CODESONLINE_IMAGE_API_KEY=
APIMART_API_KEY=

# Storage
# Production AI task outputs must use object storage with a public HTTPS CDN URL.
# Do not use STORAGE_PROVIDER=local for production mini-program releases.
STORAGE_PROVIDER=tencent_cos
LOCAL_UPLOAD_DIR=/www/wwwroot/ai-creator/uploads
LOCAL_BASE_URL=https://api.example.com/static
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_MAX_VIDEO_SIZE=209715200
FILE_CONTENT_PROXY_TIMEOUT_MS=120000

# Storage: Tencent COS
COS_SECRET_ID=PLEASE_REPLACE_WITH_COS_SECRET_ID
COS_SECRET_KEY=PLEASE_REPLACE_WITH_COS_SECRET_KEY
COS_BUCKET=PLEASE_REPLACE_WITH_COS_BUCKET
COS_REGION=ap-guangzhou
COS_CDN_DOMAIN=
COS_STS_ENDPOINT=sts.tencentcloudapi.com
COS_STS_DURATION_SECONDS=1800

# Storage: Aliyun OSS
OSS_ACCESS_KEY_ID=PLEASE_REPLACE_WITH_OSS_ACCESS_KEY_ID
OSS_ACCESS_KEY_SECRET=PLEASE_REPLACE_WITH_OSS_ACCESS_KEY_SECRET
OSS_BUCKET=PLEASE_REPLACE_WITH_OSS_BUCKET
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_REGION=oss-cn-hangzhou
OSS_CDN_DOMAIN=
OSS_RAM_ROLE_ARN=
OSS_STS_ENDPOINT=sts.cn-hangzhou.aliyuncs.com
OSS_STS_DURATION_SECONDS=900

# Storage: Qiniu
QINIU_ACCESS_KEY=PLEASE_REPLACE_WITH_QINIU_ACCESS_KEY
QINIU_SECRET_KEY=PLEASE_REPLACE_WITH_QINIU_SECRET_KEY
QINIU_BUCKET=PLEASE_REPLACE_WITH_QINIU_BUCKET
QINIU_ZONE=z0
QINIU_CDN_DOMAIN=
QINIU_CALLBACK_URL=
QINIU_CALLBACK_BODY=key=$(key)&etag=$(etag)&fsize=$(fsize)&mimeType=$(mimeType)
QINIU_TOKEN_EXPIRE_SECONDS=3600

# Storage: UpYun
UPYUN_BUCKET=PLEASE_REPLACE_WITH_UPYUN_BUCKET
UPYUN_OPERATOR=PLEASE_REPLACE_WITH_UPYUN_OPERATOR
UPYUN_PASSWORD=PLEASE_REPLACE_WITH_UPYUN_PASSWORD
UPYUN_CDN_DOMAIN=
UPYUN_RETURN_URL=

# Storage: China Mobile EOS
EOS_ACCESS_KEY=PLEASE_REPLACE_WITH_EOS_ACCESS_KEY
EOS_SECRET_KEY=PLEASE_REPLACE_WITH_EOS_SECRET_KEY
EOS_BUCKET=PLEASE_REPLACE_WITH_EOS_BUCKET
EOS_ENDPOINT=https://eos-wuxi-1.cmecloud.cn
EOS_REGION=wuxi-1
EOS_CDN_DOMAIN=
EOS_PRESIGN_EXPIRE_SECONDS=900

# ---- 数据库备份 ----
# 备份目录、保留天数、自动备份时间和 SMTP 邮件通知请在后台「备份管理」配置。
# 旧版本 BACKUP_EMAIL_* 环境变量仅作为兼容兜底，不建议新部署继续使用。
