PORT=3000
NODE_ENV=production

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=ai_creator

REDIS_URL=redis://127.0.0.1:6379/0
TASK_QUEUE_NAME=ai-creation-tasks
TASK_QUEUE_ATTEMPTS=3
TASK_QUEUE_BACKOFF_MS=1500
TASK_CONCURRENCY=3
TASK_QUOTE_TTL_SECONDS=300

JWT_SECRET=please_change_this
JWT_EXPIRES_IN=7200
JWT_REFRESH_EXPIRES_IN=31536000
ENCRYPTION_KEY=please_change_this_32_chars
CORS_ALLOWED_ORIGINS=https://your-api-domain.example.com
ENABLE_HSTS=true
# Optional override. Leave empty to use the built-in admin/API CSP.
CONTENT_SECURITY_POLICY=
# Comma-separated hosts that should serve the independent PC user web app.
WEB_APP_HOSTS=ooa8.com,www.ooa8.com

APP_ROOT_DIR=/www/wwwroot/ai-creator
UPDATE_PACKAGES_DIR=/www/wwwroot/ai-creator/update-packages
PM2_APP_NAME=ai-creator
HEALTH_CHECK_URL=http://127.0.0.1:3000/health
SYSTEM_CHECK_URL=http://127.0.0.1:3000/api/v1/admin/system/check
SYSTEM_CHECK_TOKEN=your_optional_admin_bearer_token
TASK_QUEUE_STALE_MAX_BATCH=100
TASK_QUEUE_STALE_QUEUED_MINUTES=30
TASK_QUEUE_STALE_PROCESSING_MINUTES=60
TASK_QUEUE_MAX_LENGTH=500
AI_TASK_CREATE_RATE_LIMIT_PER_MINUTE=10
ADMIN_AI_TEST_RATE_LIMIT_PER_MINUTE=3
TASK_OUTPUT_TRANSFER_ATTEMPTS=3
IMAGE_TASK_MAX_RUNNING_MINUTES=20
IMAGE_TASK_MAX_POLL_COUNT=240
VIDEO_TASK_POLL_INTERVAL_SECONDS=20
VIDEO_TASK_MAX_RUNNING_MINUTES=30
VIDEO_TASK_STALE_PROCESSING_MINUTES=45
VIDEO_TASK_MAX_POLL_COUNT=240
VIDEO_TASK_DOWNLOAD_TIMEOUT_SECONDS=120
VIDEO_TASK_UPLOAD_TIMEOUT_SECONDS=180
VIDEO_TASK_MAX_FILE_MB=200
VIDEO_TASK_POLL_BATCH_SIZE=10

STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=/www/wwwroot/ai-creator/uploads
LOCAL_BASE_URL=https://your-api-domain.example.com/static
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_MAX_VIDEO_SIZE=209715200
UPLOAD_MAX_AUDIO_SIZE=52428800
FILE_CONTENT_PROXY_TIMEOUT_MS=120000

OPENAI_API_KEY=
XIAOMA_API_KEY=
BAGEGE_API_KEY=
WELLAPI_API_KEY=
CODESONLINE_IMAGE_API_KEY=
APIMART_API_KEY=
HONGNIAO_API_KEY=
HONGNIAO_BASE_URL=https://open.hongniaoai.com
DEEPSEEK_API_KEY=

WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret

WECHAT_PAY_MCHID=your_mch_id
WECHAT_PAY_MCH_ID=your_mch_id
WECHAT_PAY_API_V3_KEY=your_api_v3_key
WECHAT_PAY_NOTIFY_URL=https://your-domain.com/api/v1/payments/wechat/notify
